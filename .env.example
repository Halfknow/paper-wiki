# PaperWiki v3 部署参数（cp .env.example .env 后按需修改；.env 已 gitignore）

# Windows 论文根目录（挂载进容器 /papers）。每个空间是其下的一个子目录：
#   <PAPERS_ROOT>/default    默认空间
#   <PAPERS_ROOT>/<spaceId>  其他空间（新建空间默认以空间 id 作子目录名）
# Docker Desktop for Windows 支持盘符路径（自动转换）。
PAPERS_ROOT=D:/papers_root

# PostgreSQL 密码（compose 内部网络使用，不对宿主暴露端口）
POSTGRES_PASSWORD=change-me

# 宿主访问端口：http://127.0.0.1:<APP_PORT>
APP_PORT=8888
